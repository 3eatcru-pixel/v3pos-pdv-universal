rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funções de Auxílio
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data;
    }
    
    function isDev() {
      return getUserData().role == 'admin' || getUserData().role == 'dev';
    }
    
    function belongsToTenant(enterpriseId) {
      return isSignedIn() && (getUserData().enterpriseId == enterpriseId || isDev());
    }

    // Regras por Coleção
    
    // Enterprises: Apenas Devs ou o próprio Dono
    match /enterprises/{entId} {
      allow read: if belongsToTenant(entId);
      allow write: if isDev();
    }
    
    // Coleções Escopadas por Empresa (Tenant Isolation)
    match /{collection}/{docId} {
      allow read: if isSignedIn() && 
        (resource == null || resource.data.enterpriseId == getUserData().enterpriseId) &&
        (request.resource == null || request.resource.data.enterpriseId == getUserData().enterpriseId);
      allow create, update, delete: if isSignedIn() && request.resource.data.enterpriseId == getUserData().enterpriseId;
        
      // Bloqueio explícito de coleções sensíveis para não-admins
      match /auditLogs/{logId} {
        allow write: if isSignedIn();
        allow read: if getUserData().role in ['owner', 'admin', 'dev'];
      }
      
      match /businessConfigs/{cfgId} {
        allow read: if isSignedIn();
        allow write: if getUserData().role in ['owner', 'admin', 'dev'];
      }
    }
    
    // Mensagens de Suporte: Qualquer um logado cria, apenas Dev lê tudo
    match /support_messages/{msgId} {
      allow create: if isSignedIn();
      allow read, update: if isDev() || (resource.data.companyId == getUserData().enterpriseId);
    }
  }
}